name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -o jelly_wallpaper.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - run: sudo chmod -R a+rwX $ANDROID_HOME
      - run: yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || true
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - run: gradle assembleDebug --no-daemon
        working-directory: jelly_wallpaper
      - run: find jelly_wallpaper -name "*.apk"
      - uses: actions/upload-artifact@v4
        with:
          name: jelly-wallpaper-apk
          path: jelly_wallpaper/**/build/outputs/apk/**/*.apk
          if-no-files-found: error
